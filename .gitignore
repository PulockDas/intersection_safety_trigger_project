*.sublime-workspace

# ── Dataset files — never commit raw data ────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z
*.rar

# ── Heavy sensor / media files ────────────────────────────────────────────────
*.pcap
*.pcapng
*.mp4
*.avi
*.mkv
*.mov
*.h264
*.ts

# ── Output artefacts — committed selectively ─────────────────────────────────
# Ignore generated zips from notebook Section 8 downloads
outputs/task0_outputs_*.zip

# Keep the outputs/ folder structure but ignore large or auto-generated files
outputs/logs/
outputs/samples/

# ── Secrets / credentials ─────────────────────────────────────────────────────
*.env
*.pem
*.key
secrets.json
credentials.json
service_account.json
